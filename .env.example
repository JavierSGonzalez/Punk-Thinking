# ==========================================================================
#  CONFIGURACIÓN DE TU IA PERSONAL
#  1) Copia este archivo y renómbralo a ".env"
#  2) Cambia solo lo que necesites; lo que dejes igual usa el valor por defecto.
#  El archivo .env es PRIVADO: nunca lo compartas ni lo subas a internet.
# ==========================================================================

# --- Identidad ---
APP_NAME=Punk Thinking
PORT=8000

# --- Motor de lenguaje: ¿quién redacta las respuestas? ---
#   ollama    → 100% local y privado. Gratis. Necesita instalar Ollama (ollama.com).
#   anthropic → Claude por API. Mejor calidad. La pregunta y los fragmentos encontrados
#               viajan a Anthropic. Necesita una clave de API con saldo.
LLM_PROVIDER=ollama

# Si usas ollama (gemma3:4b para PCs modestas; qwen2.5:7b si tienes 16 GB de RAM)
OLLAMA_MODEL=gemma3:4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=4096

# Si usas anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Conversación y búsqueda web ---
# Cuántos mensajes previos del chat recuerda PK (número par; más = más lento y más RAM)
HISTORY_MESSAGES=6
# Si no encuentra la respuesta en tus documentos, busca en la web (on/off).
# Solo sale una consulta corta de pocas palabras; nunca tus documentos ni tu historial.
WEB_SEARCH=on
#   searxng    → SearXNG en tu PC con Docker (ver README, "Búsqueda web")
#   duckduckgo → plan B sin Docker; DuckDuckGo ve la consulta
WEB_BACKEND=searxng
SEARXNG_URL=http://127.0.0.1:8888
WEB_RESULTS=5
# Si la IA no encuentra la respuesta en tu archivo adjunto, busca en la web usando el TEMA del archivo
# (se quitan correos y números largos). off = busca solo con lo que escribiste.
WEB_USE_FILE_CONTEXT=on
# Si esa consulta lleva palabras tomadas de tu archivo, PK NO busca sola: te muestra la consulta,
# puedes editarla y debes pulsar "Buscar en la web". Nada sale de tu PC sin tu permiso.
#   on  → pide permiso (recomendado)      off → busca automáticamente (puede filtrar palabras de tu archivo)
WEB_CONFIRM_FILE_QUERY=on

# --- Archivos y fotos adjuntos al chat (clip 📎, arrastrar o pegar) ---
# Modelo de Ollama que "ve" las fotos; se usa solo al subir una imagen. Se descarga con: ollama pull <nombre>
#   moondream     → el más liviano (1,7 GB); pensado para equipos modestos
#   qwen2.5vl:3b  → orientado a documentos, tablas y gráficos (3,2 GB)
#   gemma3:4b     → uso general (3,4 GB)
# (gemma3:1b NO sirve: no ve imágenes.) Con LLM_PROVIDER=anthropic, las fotos las analiza Claude.
VISION_MODEL=moondream
ATTACH_MAX_MB=15
ATTACH_MAX_PER_MESSAGE=4

# --- Modo asistente (pestaña «Asistente»: hablas y PK te responde con voz) ---
# OÍDO (voz → texto), 100 % en tu PC con Whisper. El audio no sale ni se guarda.
# La primera vez descarga el modelo (una sola vez, necesita internet; no se envía nada tuyo).
#   tiny  → ~75 MB, el más rápido, entiende menos     base  → ~145 MB, equilibrado (por defecto)
#   small → ~480 MB, entiende mejor, más lento en equipos modestos
WHISPER_MODEL=base
VOICE_LANGUAGE=es
# VOZ (texto → audio): windows = las voces instaladas en tu PC (local). browser = voces locales del navegador.
VOICE_ENGINE=windows
# Parte del nombre de la voz que quieres. Para ver cuáles tienes: python -m core.voice
# Ejemplos: Helena · Sabina · Pablo · Loquendo · Jorge. Vacío = una voz en español.
VOICE_NAME=
# Velocidad de la voz: -10 (lenta) a 10 (rápida)
VOICE_RATE=0
# Lo máximo que PK dice en voz alta; el resto queda en pantalla
VOICE_MAX_CHARS=450

# --- Búsqueda en tus documentos ---
# Modelo de búsqueda multilingüe (se descarga una sola vez, ~220 MB).
# Alternativa más precisa en español (~640 MB): jinaai/jina-embeddings-v2-base-es
# Si cambias el modelo, reconstruye el índice con: python ingest.py --todo
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=5
# Similitud mínima (0 a 1) para usar un fragmento. Si responde "no tengo esa información"
# y sí debería saberlo, bájala (0.15); si usa fragmentos que no vienen al caso, súbela (0.35).
MIN_SCORE=0.25
CHUNK_SIZE=800
CHUNK_OVERLAP=150
